# Sentry PoC environment configuration
# Copy to .env and adjust if needed:
#   cp .env.example .env
#
# DSNs below are public ingestion keys for this PoC. Do not put auth tokens here.

# ---------------------------------------------------------------------------
# Shared metadata
# ---------------------------------------------------------------------------
SENTRY_ENVIRONMENT=poc
SENTRY_RELEASE=sentry-poc@1.0.0

# PoC tracing sample rate. Isolated here on purpose.
# 1.0 makes distributed-trace validation reliable.
# Production MUST use a much lower rate or dynamic tracesSampler.
SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0

# Session Replay and Profiling are intentionally not configured.

# ---------------------------------------------------------------------------
# Sentry DSNs (public ingestion keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://7918f155a0fab603640ddeb08b41d0db@o4511829061992448.ingest.us.sentry.io/4512097256341504
SENTRY_DSN_SPRING=https://592ab4764472a9f971f8b9dcc9d65663@o4511829061992448.ingest.us.sentry.io/4512097261453312
SENTRY_DSN_PYTHON_DIRECT=https://5515884fa633370749a13c4a05901d4a@o4511829061992448.ingest.us.sentry.io/4512097265188865
SENTRY_DSN_PYTHON_DOWNSTREAM=https://b63291fb93c9f796142d94db0c14312d@o4511829061992448.ingest.us.sentry.io/4512097268006912

NEXT_PUBLIC_SENTRY_ENVIRONMENT=poc
NEXT_PUBLIC_SENTRY_RELEASE=sentry-poc@1.0.0

# ---------------------------------------------------------------------------
# Source map upload (required for production frontend stack-trace validation)
# Create a Sentry auth token later:
#   Sentry → Settings → Auth Tokens → Create New Token
# Required scopes typically include: project:releases, org:read
# Never commit the token.
# ---------------------------------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=sentry-poc-next
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Local service URLs / ports
# ---------------------------------------------------------------------------
NEXT_PORT=3000
SPRING_PORT=8080
PYTHON_DIRECT_PORT=8001
PYTHON_DOWNSTREAM_PORT=8002

PYTHON_DIRECT_URL=http://127.0.0.1:8001
SPRING_URL=http://127.0.0.1:8080
PYTHON_DOWNSTREAM_URL=http://127.0.0.1:8002

# Next.js server-side outbound targets
PYTHON_DIRECT_BASE_URL=http://127.0.0.1:8001
SPRING_BASE_URL=http://127.0.0.1:8080

# Spring → Python Downstream
SENTRY_POC_DOWNSTREAM_BASE_URL=http://127.0.0.1:8002

# Optional default mode for GET /api/uptime-test when no ?mode= is provided.
# empty | error | slow
SENTRY_POC_UPTIME_MODE=

# Next.js / Java / Python log level
LOG_LEVEL=INFO
